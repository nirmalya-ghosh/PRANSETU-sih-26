    <string name="onboarding_capability_title">PRANSETU क्या करता है</string>
    <string name="onboarding_capability_desc">PRANSETU आपके आपातकालीन SOS को संरक्षित करता है जब सभी कनेक्टिविटी विफल हो जाती है, पास के उपकरणों के माध्यम से रिले करता है, और आपातकालीन ऑपरेटरों तक पहुँचाता है।</string>
    <string name="onboarding_capability_1">इंटरनेट के बिना भी SOS भेजें</string>
    <string name="onboarding_capability_2">पास के PRANSETU उपकरणों के माध्यम से रिले</string>
    <string name="onboarding_capability_3">अपनी भाषा में आपदा अलर्ट प्राप्त करें</string>
    <string name="onboarding_perm_location_title">स्थान अनुमति</string>
    <string name="onboarding_perm_location_desc">PRANSETU आपातकाल के दौरान आपके स्थान का उपयोग करता है ताकि आपके SOS में आपकी स्थिति शामिल हो। इससे बचावकर्ताओं को आपको खोजने में मदद मिलती है।</string>
    <string name="onboarding_perm_nearby_title">पास के उपकरण अनुमति</string>
    <string name="onboarding_perm_nearby_desc">PRANSETU सामान्य कनेक्टिविटी उपलब्ध न होने पर SOS रिले करने में मदद के लिए पास के उपकरण संचार का उपयोग कर सकता है।</string>
    <string name="onboarding_perm_notification_title">सूचना अनुमति</string>
    <string name="onboarding_perm_notification_desc">PRANSETU महत्वपूर्ण आपदा अलर्ट और SOS डिलीवरी अपडेट सूचनाओं के रूप में भेजता है।</string>
    <string name="onboarding_permissions_title">अनुमतियाँ दें</string>
    <string name="onboarding_permissions_desc">जिन अनुमतियों के बारे में आपने अभी जाना, उन्हें दें। आप बाद में Android सेटिंग्स में इन्हें प्रबंधित कर सकते हैं।</string>
    <string name="onboarding_auth_title">साइन इन</string>
    <string name="onboarding_auth_desc">आपातकालीन सेवाएँ सक्षम करने के लिए PRANSETU में साइन इन करें।</string>
    <string name="onboarding_profile_title">आपकी प्रोफ़ाइल</string>
    <string name="onboarding_profile_desc">हमें अपने बारे में थोड़ा बताएं। यह जानकारी आपातकाल के दौरान बचावकर्ताओं की मदद करती है।</string>
    <string name="onboarding_contacts_title">आपातकालीन संपर्क</string>
    <string name="onboarding_contacts_desc">उन लोगों को जोड़ें जिन्हें आपके SOS भेजने पर सूचित किया जाना चाहिए।</string>
